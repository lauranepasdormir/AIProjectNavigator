# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/database_name

# OpenAI API (Optional - for AI content generation)
OPENAI_API_KEY=your_openai_api_key_here

# Environment
NODE_ENV=development

# Development/Production Database URLs (Optional)
DEV_DATABASE_URL=postgresql://username:password@localhost:5432/dev_database
PROD_DATABASE_URL=postgresql://username:password@localhost:5432/prod_database